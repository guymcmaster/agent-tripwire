{
  "description": "Agent Tripwire hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SessionStart --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook PreToolUse --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook PostToolUse --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SubagentStart --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SubagentStop --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook Stop --cli codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SessionEnd --cli codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
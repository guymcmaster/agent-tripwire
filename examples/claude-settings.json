{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SessionStart --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook PreToolUse --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook PostToolUse --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook PostToolUseFailure --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SubagentStart --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SubagentStop --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook Stop --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook StopFailure --cli claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agent-tripwire/bin/tripwire.py hook SessionEnd --cli claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}